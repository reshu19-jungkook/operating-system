#include <stdio.h>

int main() {
    int index[20],n,i;

    printf("Enter number of blocks: ");
    scanf("%d",&n);

    printf("Enter block numbers: ");
    for(i=0;i<n;i++)
        scanf("%d",&index[i]);

    printf("Index Block:\n");

    for(i=0;i<n;i++)
        printf("Entry %d -> Block %d\n",i,index[i]);

    return 0;
}

input:
Enter number of blocks: 4
Enter block numbers: 5 9 13 20
output:
Index Block:
Entry 0 -> Block 5
Entry 1 -> Block 9
Entry 2 -> Block 13
Entry 3 -> Block 20
