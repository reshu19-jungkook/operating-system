#include <stdio.h>
#include <unistd.h>

int main()
{
    printf("Process ID: %d\n", getpid());
    printf("Parent Process ID: %d\n", getppid());

    fork();   // Create a new process

    printf("After fork\n");
    printf("Process ID: %d\n", getpid());
    printf("Parent Process ID: %d\n", getppid());

    return 0;
}

